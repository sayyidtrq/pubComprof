# Supabase (Project Settings > API). Publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare R2 (R2 > Manage API tokens, Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pub-comprof
# Public bucket URL, e.g. https://pub-xxxx.r2.dev or https://media.example.com (no trailing slash)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
